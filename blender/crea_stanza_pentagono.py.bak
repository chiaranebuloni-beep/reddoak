# ================================================================ modelli veri (Poly Haven)
_stampi = {}
c_stampi = collezione("Stampi (cancellati a fine script)")


def modello(nome, etichetta, coll, padre=None, loc=(0, 0, 0), rot_z=0.0, scala=1.0, altezza=None, solo_foto=False):
    """Mette nella stanza una copia di un modello Poly Haven. Poggia a terra sul punto 'loc'.
    altezza = quanto dev'essere alto in metri (se manca usa 'scala')."""
    if nome not in _stampi:
        prima = set(bpy.data.objects)
        bpy.ops.import_scene.gltf(filepath=os.path.join(RIS, "modelli", nome, nome + ".gltf"))
        nuovi = [o for o in bpy.data.objects if o not in prima]
        bpy.context.view_layer.update()
        pts = [o.matrix_world @ Vector(c) for o in nuovi if o.type == "MESH" for c in o.bound_box]
        lo = Vector((min(p.x for p in pts), min(p.y for p in pts), min(p.z for p in pts)))
        hi = Vector((max(p.x for p in pts), max(p.y for p in pts), max(p.z for p in pts)))
        for o in nuovi:
            for c in list(o.users_collection):
                c.objects.unlink(o)
            c_stampi.objects.link(o)
        _stampi[nome] = (nuovi, lo, hi)
        d = hi - lo
        print(f"Modello {nome}: {d.x:.2f} x {d.y:.2f} x {d.z:.2f} m, {len(nuovi)} oggetti")
    nuovi, lo, hi = _stampi[nome]
    if altezza:
        scala = altezza / (hi.z - lo.z)
    g = vuoto(etichetta, coll, padre, loc, (0, 0, rot_z), 0.25)
    g.scale = (scala, scala, scala)
    copie = {}
    for o in nuovi:
        c = o.copy()
        c.name = f"{etichetta} · {o.name}"
        coll.objects.link(c)
        if solo_foto:
            c["solo_foto"] = True
        copie[o] = c
    piede = Vector(((lo.x + hi.x) / 2, (lo.y + hi.y) / 2, lo.z))
    for o, c in copie.items():
        if o.parent in copie:
            c.parent = copie[o.parent]
        else:
            c.parent = g
            c.location = Vector(o.location) - piede
    return g


_rossi = {}


def _foglie_rosse(c):
    """Da foglie verdi a foglie da quercia rossa in autunno."""
    r, g, b = c[..., 0], c[..., 1], c[..., 2]
    return np.stack([np.clip(g * 1.55 + 0.05, 0, 1), r * 0.42, b * 0.3], axis=-1)


def arrossa(gruppo):
    """Trasforma un albero verde in una quercia rossa: stesso modello, foglie ricolorate."""
    for ob in gruppo.children_recursive:
        if ob.type != "MESH":
            continue
        if ob.data.name not in _rossi:
            mesh = ob.data.copy()
            for i, m in enumerate(mesh.materials):
                if m is None:
                    continue
                immagini = [n for n in m.node_tree.nodes if n.type == "TEX_IMAGE" and n.image
                            and "leaves_diff" in os.path.basename(n.image.filepath)]
                if not immagini:
                    continue
                m2 = m.copy()
                m2.name = m.name + " · rosso"
                for n in m2.node_tree.nodes:
                    if n.type == "TEX_IMAGE" and n.image and "leaves_diff" in os.path.basename(n.image.filepath):
                        origine = bpy.path.abspath(n.image.filepath)
                        n.image = carica(variante(origine, os.path.join(TEX, "foglie-rosse.jpg"), _foglie_rosse))
                mesh.materials[i] = m2
            _rossi[ob.data.name] = mesh
        ob.data = _rossi[ob.data.name]


def albero(etichetta, coll, padre, loc, alto, rosso=False):
    """Albero vero in una grande fioriera di cemento."""
    g = vuoto(etichetta, coll, padre, loc, (0, 0, 0), 0.3)
    vaso = uv_metri(cilindro(f"{etichetta} · fioriera", 0.6, 0.0, 0.62, M_CEMENTO, coll), LATO_CEMENTO)
    vaso.parent = g
    cilindro(f"{etichetta} · terra", 0.54, 0.6, 0.625, M_TERRA, coll).parent = g
    t = modello("tree_small_02", f"{etichetta} · albero", coll, g, (0, 0, 0.6), rng.uniform(0, 6.28),
                altezza=alto, solo_foto=True)
    if rosso:
        arrossa(t)
    return g


# ================================================================ struttura
c_stanza = collezione("Atrio")
c_soffitto = collezione("Soffitto (nascosto nella vista, si vede nel render)")
c_verde = collezione("Alberi e piante")
centro_occhi = (0, 0, OCCHI)

# pavimento a grandi lastre di pietra chiara
piano_orientato("Pavimento", poligono(RAGGIO, 0.0), M_PIETRA, c_stanza, (0, 0, 10), lato=LATO_PIETRA)

# ---------------------------------------------------------------- pareti e vetrate a tutta altezza
for k in range(5):
    a, b = punto(k), punto(k + 1)
    lung = (b - a).length
    lungo = (b - a).normalized()
    dentro = (-(a + b) / 2).normalized()
    mezzo = (a + b) / 2
    rot_muro = math.atan2(mezzo.y, mezzo.x) - math.pi / 2   # -Y locale verso il centro

    def p(t, z, fuori=0.0, a=a, lungo=lungo, dentro=dentro):
        v = a + lungo * t - dentro * fuori
        return (v.x, v.y, z)

    if k == PARETE_REDDOAK:
        piano_orientato(f"Parete {k + 1}", [p(0, 0), p(lung, 0), p(lung, ALTEZZA), p(0, ALTEZZA)],
                        M_INTONACO, c_stanza, centro_occhi, lato=LATO_INTONACO)
        continue

    t0, t1 = lung / 2 - VETRO_LARG / 2, lung / 2 + VETRO_LARG / 2
    S_ = SPESSORE_MURO
    centro_vetro = Vector(p(lung / 2, VETRO_ALT / 2, S_ / 2))
    for nome, verts, verso in (
        ("sinistra", [p(0, 0), p(t0, 0), p(t0, ALTEZZA), p(0, ALTEZZA)], centro_occhi),
        ("destra", [p(t1, 0), p(lung, 0), p(lung, ALTEZZA), p(t1, ALTEZZA)], centro_occhi),
        ("sopra", [p(t0, VETRO_ALT), p(t1, VETRO_ALT), p(t1, ALTEZZA), p(t0, ALTEZZA)], centro_occhi),
        ("spalla sx", [p(t0, 0), p(t0, 0, S_), p(t0, VETRO_ALT, S_), p(t0, VETRO_ALT)], centro_vetro),
        ("spalla dx", [p(t1, 0), p(t1, 0, S_), p(t1, VETRO_ALT, S_), p(t1, VETRO_ALT)], centro_vetro),
        ("architrave", [p(t0, VETRO_ALT), p(t1, VETRO_ALT), p(t1, VETRO_ALT, S_), p(t0, VETRO_ALT, S_)], centro_vetro),
    ):
        piano_orientato(f"Parete {k + 1} · {nome}", verts, M_INTONACO, c_stanza, verso, lato=LATO_INTONACO)
    piano_orientato(f"Parete {k + 1} · soglia", [p(t0, 0), p(t1, 0), p(t1, 0, S_), p(t0, 0, S_)],
                    M_PIETRA, c_stanza, centro_vetro, lato=LATO_PIETRA)

    # facciata vetrata: telaio sottile in alluminio scuro, agganciato a un Empty ai piedi del vetro
    vet = vuoto(f"VETRATA_{k + 1}", c_stanza, None, (mezzo.x, mezzo.y, 0), (0, 0, rot_muro), 0.3)
    L2 = VETRO_LARG / 2
    pezzi = [("telaio sx", (0.1, 0.18, VETRO_ALT), (-L2 + 0.05, 0.22, VETRO_ALT / 2)),
             ("telaio dx", (0.1, 0.18, VETRO_ALT), (L2 - 0.05, 0.22, VETRO_ALT / 2)),
             ("telaio alto", (VETRO_LARG, 0.18, 0.1), (0, 0.22, VETRO_ALT - 0.05)),
             ("telaio basso", (VETRO_LARG, 0.18, 0.1), (0, 0.22, 0.05))]
    for i, x in enumerate((-1.25, 0.0, 1.25)):
        pezzi.append((f"montante {i + 1}", (0.06, 0.16, VETRO_ALT), (x, 0.22, VETRO_ALT / 2)))
    for i, z in enumerate((2.65, 5.3, 7.95)):
        pezzi.append((f"traverso {i + 1}", (VETRO_LARG, 0.16, 0.06), (0, 0.22, z)))
    for nome, dim, loc in pezzi:
        scatola(f"Vetrata {k + 1} · {nome}", dim, loc, M_ANTRACITE, c_stanza).parent = vet

    # un albero vero da un lato della vetrata, piante dall'altro
    lato_albero = -1 if k % 2 == 0 else 1
    albero(f"Albero vetrata {k + 1}", c_verde, vet, (lato_albero * 1.2, -1.3, 0), rng.uniform(3.6, 4.0))
    modello("potted_plant_02", f"Pianta vetrata {k + 1}a", c_verde, vet, (-lato_albero * 2.0, -0.95, 0),
            rng.uniform(0, 6.28), altezza=1.25)
    modello("potted_plant_01", f"Pianta vetrata {k + 1}b", c_verde, vet, (-lato_albero * 1.2, -0.7, 0),
            rng.uniform(0, 6.28), altezza=0.95)

# ---------------------------------------------------------------- soffitto, travi e grande lucernario
for k in range(5):
    a0, b0, a1, b1 = punto(k, R_LUCERNARIO), punto(k + 1, R_LUCERNARIO), punto(k, RAGGIO), punto(k + 1, RAGGIO)
    piano_orientato(f"Soffitto {k + 1}",
                    [(a0.x, a0.y, ALTEZZA), (b0.x, b0.y, ALTEZZA), (b1.x, b1.y, ALTEZZA), (a1.x, a1.y, ALTEZZA)],
                    M_INTONACO, c_soffitto, centro_occhi, lato=LATO_INTONACO)
    piano_orientato(f"Lucernario {k + 1} · pozzo",
                    [(a0.x, a0.y, ALTEZZA), (b0.x, b0.y, ALTEZZA), (b0.x, b0.y, ALTEZZA + 1.0), (a0.x, a0.y, ALTEZZA + 1.0)],
                    M_INTONACO, c_soffitto, (0, 0, ALTEZZA + 0.5), lato=LATO_INTONACO)
    # faretti incassati
    for i in range(5):
        f_ = punto(k, 7.4).lerp(punto(k + 1, 7.4), (i + 1) / 6)
        cilindro(f"Faretto {k + 1}.{i + 1} · ghiera", 0.1, ALTEZZA - 0.012, ALTEZZA, M_ANTRACITE, c_soffitto, f_.x, f_.y)
        cilindro(f"Faretto {k + 1}.{i + 1}", 0.07, ALTEZZA - 0.016, ALTEZZA - 0.01, M_FARETTO, c_soffitto, f_.x, f_.y)


def trave(nome, a, b, larg, alt, z, mat, coll, smusso=0.02):
    a, b = Vector(a), Vector(b)
    d = b - a
    return scatola(nome, (d.length, larg, alt), ((a.x + b.x) / 2, (a.y + b.y) / 2, z), mat, coll,
                   smusso=smusso, rot=(0, 0, math.atan2(d.y, d.x)))


R_ANELLO, Z_ANELLO = 3.5, 8.6
for k in range(5):
    trave(f"Trave {k + 1}", punto(k, R_LUCERNARIO - 0.1), punto(k, RAGGIO - 0.05), 0.5, 0.7, ALTEZZA - 0.35, M_BIANCO, c_soffitto)
    trave(f"Trave anello {k + 1}", punto(k, R_LUCERNARIO + 0.2), punto(k + 1, R_LUCERNARIO + 0.2), 0.5, 0.7, ALTEZZA - 0.35, M_BIANCO, c_soffitto)
    trave(f"Lucernario · raggio {k + 1}", (0, 0, 0), punto(k, R_LUCERNARIO), 0.1, 0.18, ALTEZZA + 0.9, M_ANTRACITE, c_soffitto, 0.0)
    trave(f"Lucernario · bordo {k + 1}", punto(k, R_LUCERNARIO), punto(k + 1, R_LUCERNARIO), 0.1, 0.18, ALTEZZA + 0.9, M_ANTRACITE, c_soffitto, 0.0)
    trave(f"Lucernario · mezzo {k + 1}", punto(k, R_LUCERNARIO / 2), punto(k + 1, R_LUCERNARIO / 2), 0.08, 0.14, ALTEZZA + 0.9, M_ANTRACITE, c_soffitto, 0.0)
    # grande anello luminoso sospeso: alluminio scuro sopra, luce sotto
    trave(f"Anello · corpo {k + 1}", punto(k, R_ANELLO), punto(k + 1, R_ANELLO), 0.16, 0.1, Z_ANELLO + 0.06, M_ANTRACITE, c_soffitto, 0.01)
    trave(f"Anello · luce {k + 1}", punto(k, R_ANELLO), punto(k + 1, R_ANELLO), 0.12, 0.03, Z_ANELLO, M_LUCE_ANELLO, c_soffitto, 0.0)
    pa = punto(k, R_ANELLO)
    tubo(f"Anello cavo {k + 1}", (pa.x, pa.y, Z_ANELLO + 0.1), (pa.x, pa.y, ALTEZZA + 0.9), 0.008, M_ACCIAIO, c_soffitto)

# ---------------------------------------------------------------- parete Reddoak: boiserie in rovere, logo e reception
a, b = punto(PARETE_REDDOAK), punto(PARETE_REDDOAK + 1)
mezzo = (a + b) / 2
muro = vuoto("PARETE_REDDOAK", c_stanza, None, (mezzo.x, mezzo.y, 0),
             (0, 0, math.atan2(mezzo.y, mezzo.x) - math.pi / 2), 0.4)   # -Y locale verso il centro

COLONNE, RIGHE, FUGA = 6, 4, 0.012
larg_pannello, alt_pannello = 6.6 / COLONNE, ALTEZZA / RIGHE
for c in range(COLONNE):
    for r in range(RIGHE):
        pan = scatola(f"Boiserie {c + 1}.{r + 1}", (larg_pannello - FUGA, 0.05, alt_pannello - FUGA),
                      (-3.3 + larg_pannello * (c + 0.5), -0.025, alt_pannello * (r + 0.5)), M_ROVERE, c_stanza, smusso=0.004)
        uv_metri(pan, LATO_ROVERE, sposta=(rng.random(), rng.random()))
        pan.parent = muro

logo = piano_immagine("Reddoak · logo", 5.2, 5.2 * 180 / 770, materiale_logo("Logo Reddoak", "reddoak-logo.png", 1.0), c_stanza)
logo.parent = muro
logo.location = (0, -0.058, 6.6)

banco = scatola("Reception · banco", (4.6, 0.85, 1.02), (0, -2.4, 0.61), M_ROVERE, c_stanza, smusso=0.006)
uv_metri(banco, LATO_ROVERE, ruota=True)
for ob in (
    banco,
    scatola("Reception · zoccolo", (4.5, 0.75, 0.1), (0, -2.4, 0.05), M_ANTRACITE, c_stanza),
    scatola("Reception · filo rosso", (4.56, 0.81, 0.012), (0, -2.4, 0.094), M_ROSSO_LUCE, c_stanza),
    scatola("Reception · piano", (4.8, 1.0, 0.045), (0, -2.42, 1.1425), M_PIANO, c_stanza, smusso=0.006),
):
    ob.parent = muro
for i, x in enumerate((-1.2, 1.2)):   # i due computer della reception, visti da dietro
    scatola(f"Reception · monitor {i + 1}", (0.62, 0.02, 0.38), (x, -2.2, 1.44), M_NERO, c_stanza, smusso=0.004).parent = muro
    scatola(f"Reception · monitor {i + 1} luce", (0.58, 0.004, 0.34), (x, -2.188, 1.44), M_MONITOR, c_stanza).parent = muro
    tubo(f"Reception · monitor {i + 1} stelo", (x, -2.22, 1.165), (x, -2.22, 1.36), 0.018, M_ACCIAIO, c_stanza).parent = muro
    cilindro(f"Reception · monitor {i + 1} base", 0.11, 1.165, 1.175, M_ACCIAIO, c_stanza, x, -2.22).parent = muro
modello("potted_plant_04", "Reception · pianta", c_stanza, muro, (2.0, -2.5, 1.165), 1.1, altezza=0.34)

# la ghianda: scultura in bronzo sul banco della reception (da piccola ghianda a grande quercia)
ghianda = vuoto("GHIANDA", c_stanza, muro, (-1.95, -2.45, 1.165), (0, 0, 0), 0.2)
ghianda.scale = (0.55, 0.55, 0.55)
punta = cono("Ghianda · punta", 0.05, 0.0, 0.09, (0, 0, 0.06), M_BRONZO, c_stanza)
punta.rotation_euler = (math.pi, 0, 0)
for ob in (
    sfera("Ghianda · corpo", 0.3, (0, 0, 0.45), M_BRONZO, c_stanza, scala=(1, 1, 1.28)),
    sfera("Ghianda · cappello", 0.33, (0, 0, 0.71), M_BRONZO_SCURO, c_stanza, scala=(1, 1, 0.56)),
    tubo("Ghianda · picciolo", (0, 0, 0.83), (0.05, 0, 1.01), 0.03, M_BRONZO_SCURO, c_stanza),
    punta,
):
    ob.parent = ghianda

# la quercia rossa sotto il logo, dietro la reception: il simbolo di Reddoak
albero("Quercia rossa", c_verde, muro, (0, -0.95, 0), 4.5, rosso=True)
luce_spot("Faro logo", c_stanza, (0, -4.2, ALTEZZA - 0.4), (0, -0.1, 5.0), 5000, 46, padre=muro)
luce_spot("Faro reception", c_stanza, (0, -3.2, ALTEZZA - 0.4), (0, -2.4, 1.0), 4000, 36, padre=muro)

# ================================================================ i 5 angoli: grande schermo e salottino
c_hotspot = collezione("Hotspot (punti cliccabili sul sito)")
CORPO_L, CORPO_P, CORPO_H = SCHERMO_L + 0.16, 0.32, SCHERMO_H + 0.6   # il totem che regge lo schermo
POLTRONE = ("modern_arm_chair_01", "mid_century_lounge_chair")

for k, prog in enumerate(PROGETTI):
    coll = collezione(f"Angolo {k + 1} · {prog['nome']}")
    N = prog["nome"]
    ang = math.radians(angolo_gradi(k))
    dir_ = Vector((math.cos(ang), math.sin(ang), 0))
    P = punto(k)

    # Tutto l'angolo e' agganciato a questo Empty: spostandolo si sposta l'angolo intero.
    # +Y locale va verso l'angolo (il fondo), -Y verso il centro della stanza, +X e' la destra di chi guarda.
    base = vuoto(f"ANGOLO_{k + 1}_{prog['id']}", coll, None, P - dir_ * DIST_SCHERMO, (0, 0, ang - math.pi / 2), 0.5)
    base.empty_display_type = "ARROWS"

    def S(ob, base=base):
        ob.parent = base
        return ob

    # totem in alluminio scuro con il grande schermo verticale
    S(scatola(f"{N} · totem", (CORPO_L, CORPO_P, CORPO_H), (0, 0, CORPO_H / 2), M_ANTRACITE, coll, smusso=0.01))
    schermo = S(piano_immagine(f"{N} · schermo", SCHERMO_L, SCHERMO_H,
                               materiale_schermo(f"Schermo {N}", f"schermo-{prog['id']}.png"), coll))
    schermo.location = (0, -CORPO_P / 2 - 0.004, 0.5 + SCHERMO_H / 2)
    # luce nel colore del progetto dietro e sopra il totem: tinge il muro dell'angolo
    m_alone = materiale(f"{N} · alone", prog["colore"], luce=12.0)
    for lato in (-1, 1):
        S(scatola(f"{N} · alone {'sx' if lato < 0 else 'dx'}", (0.03, CORPO_P - 0.08, CORPO_H - 0.1),
                  (lato * (CORPO_L / 2 + 0.012), 0.02, CORPO_H / 2), m_alone, coll))
    S(scatola(f"{N} · alone sopra", (CORPO_L - 0.1, CORPO_P - 0.08, 0.03), (0, 0.02, CORPO_H + 0.012), m_alone, coll))

    # salottino davanti allo schermo
    tappeto = S(scatola(f"{N} · tappeto", (3.8, 2.6, 0.018), (0, -2.55, 0.009), M_TESSUTO, coll, smusso=0.004))
    uv_metri(tappeto, LATO_TESSUTO)
    poltrona = POLTRONE[k % 2]
    modello(poltrona, f"{N} · poltrona sx", coll, base, (-1.4, -2.35, 0.018), math.radians(62))
    modello(poltrona, f"{N} · poltrona dx", coll, base, (1.4, -2.35, 0.018), math.radians(-62))
    modello("coffee_table_round_01", f"{N} · tavolino", coll, base, (0, -2.6, 0.018), rng.uniform(0, 6.28))
    modello("ceramic_vase_03" if k % 2 else "ceramic_vase_01", f"{N} · vaso", coll, base,
            (0.12, -2.55, 0.018 + 0.42), rng.uniform(0, 6.28), altezza=0.3)
    modello("potted_plant_02", f"{N} · pianta", c_verde, base, (-2.55 if k % 2 else 2.55, -0.85, 0),
            rng.uniform(0, 6.28), altezza=1.35)

    # lampade a sospensione ai lati (fuori dalla visuale dello schermo) e faro dal soffitto
    for i, (x, y, z) in enumerate(((-2.45, -2.3, 3.15), (2.45, -2.3, 2.75))):
        lamp = modello("modern_ceiling_lamp_01", f"{N} · lampada {i + 1}", coll, base, (x, y, z), rng.uniform(0, 6.28))
        _, lo_, hi_ = _stampi["modern_ceiling_lamp_01"]
        cima = z + (hi_.z - lo_.z)
        S(tubo(f"{N} · lampada {i + 1} cavo", (x, y, cima - 0.02), (x, y, ALTEZZA), 0.004, M_NERO, coll))
        pl = bpy.data.lights.new(f"Lampadina {N} {i + 1}", "POINT")
        pl.energy = 140
        pl.shadow_soft_size = 0.12
        pl.color = (1.0, 0.89, 0.76)
        pl_ob = bpy.data.objects.new(f"Lampadina {N} {i + 1}", pl)
        coll.objects.link(pl_ob)
        S(pl_ob).location = (x, y, z - 0.12)
    luce_spot(f"Faro {N}", coll, (0, -2.8, ALTEZZA - 0.4), (0, -2.5, 0.3), 5000, 40, padre=base)

    # punto cliccabile: sul sito diventa il bollino rotante del progetto (sopra il tavolino del salottino)
    hs = bpy.data.objects.new(f"HOTSPOT_{prog['id']}", None)
    hs.empty_display_type = "SPHERE"
    hs.empty_display_size = 0.16
    hs["titolo"] = N
    c_hotspot.objects.link(hs)
    hs.parent = base
    hs.location = (0, -2.6, 0.3)

# gli stampi dei modelli non servono piu': restano solo le copie messe nella stanza
for nuovi, _, _ in _stampi.values():
    for o in nuovi:
        bpy.data.objects.remove(o, do_unlink=True)
bpy.data.collections.remove(c_stampi)

# ================================================================ sole e cielo vero
sole_dati = bpy.data.lights.new("Sole", "SUN")
sole_dati.energy = 2.2
sole_dati.angle = math.radians(2.5)
sole_dati.color = (1.0, 0.95, 0.88)
sole = bpy.data.objects.new("Sole", sole_dati)
scena.collection.objects.link(sole)
sole.location = (0, 0, ALTEZZA + 8)
azimut, elevazione = math.radians(54), math.radians(64)   # la lama di sole cade davanti, tra i primi due angoli
verso_luce = Vector((math.cos(azimut) * math.cos(elevazione), math.sin(azimut) * math.cos(elevazione), -math.sin(elevazione)))
sole.rotation_mode = "QUATERNION"
sole.rotation_quaternion = verso_luce.to_track_quat("-Z", "Y")

mondo = scena.world or bpy.data.worlds.new("Cielo")
scena.world = mondo
mondo.name = "Cielo vero (Canary Wharf)"
if mondo.node_tree is None:
    mondo.use_nodes = True
# la fotografia a 360 gradi della citta' fa da cielo. Quella che si VEDE dalle vetrate ha la sua
# luminosita', quella che ILLUMINA la stanza e' piu' forte (come una foto esposta per l'interno).
nt = mondo.node_tree
nt.nodes.clear()
w_out = nt.nodes.new("ShaderNodeOutputWorld")
w_coord = nt.nodes.new("ShaderNodeTexCoord")
w_gira = nt.nodes.new("ShaderNodeMapping")
w_gira.inputs["Rotation"].default_value = (0, 0, math.radians(ROT_CIELO))
w_foto = nt.nodes.new("ShaderNodeTexEnvironment")
w_foto.image = carica(os.path.join(RIS, "cielo", "canary_wharf.hdr"))
nt.links.new(w_coord.outputs["Generated"], w_gira.inputs["Vector"])
nt.links.new(w_gira.outputs["Vector"], w_foto.inputs["Vector"])
w_luce = nt.nodes.new("ShaderNodeBackground")
w_luce.inputs[1].default_value = LUCE_CIELO
w_vista = nt.nodes.new("ShaderNodeBackground")
w_vista.inputs[1].default_value = VISTA_CIELO
nt.links.new(w_foto.outputs["Color"], w_luce.inputs[0])
nt.links.new(w_foto.outputs["Color"], w_vista.inputs[0])
w_raggio = nt.nodes.new("ShaderNodeLightPath")
w_mix = nt.nodes.new("ShaderNodeMixShader")
nt.links.new(w_raggio.outputs["Is Camera Ray"], w_mix.inputs[0])
nt.links.new(w_luce.outputs[0], w_mix.inputs[1])
nt.links.new(w_vista.outputs[0], w_mix.inputs[2])
nt.links.new(w_mix.outputs[0], w_out.inputs["Surface"])
mondo.color = colore(CIELO)[:3]
mondo["cielo"] = CIELO   # letto dall'esportazione: e' lo sfondo del "3D dal vivo"

# ================================================================ camera 360
cam_data = bpy.data.cameras.new("Camera360")
cam_data.type = "PANO"
try:
    cam_data.panorama_type = "EQUIRECTANGULAR"
except Exception:
    cam_data.cycles.panorama_type = "EQUIRECTANGULAR"
cam = bpy.data.objects.new("Camera360", cam_data)
scena.collection.objects.link(cam)
cam.location = (0, 0, OCCHI)
cam.rotation_euler = (math.radians(90), 0, 0)   # guarda verso +Y, cioe' l'angolo 1
scena.camera = cam

# ================================================================ render
scena.render.engine = "CYCLES"
scena.render.resolution_x = 5760      # la stessa misura del panorama di engine.land
scena.render.resolution_y = 2880
scena.render.resolution_percentage = 100
scena.cycles.samples = 160
scena.cycles.use_adaptive_sampling = True
scena.cycles.adaptive_threshold = 0.015
scena.cycles.use_denoising = True
scena.cycles.sample_clamp_indirect = 8.0     # niente puntini bianchi sul pavimento lucido
scena.cycles.caustics_reflective = False
scena.cycles.caustics_refractive = False
try:
    scena.cycles.device = "GPU"
except Exception:
    pass
for nome_vista in ("Khronos PBR Neutral", "Standard", "AgX"):   # la prima tiene i colori dei marchi fedeli
    try:
        scena.view_settings.view_transform = nome_vista
        break
    except Exception:
        continue
for look in ("None",):
    try:
        scena.view_settings.look = look
        break
    except Exception:
        continue

# soffitto nel render ma non davanti agli occhi mentre lavori nella vista dall'alto
for lc in bpy.context.view_layer.layer_collection.children:
    if lc.name.startswith("Soffitto"):
        lc.hide_viewport = True

# vista 3D in modalita' "Anteprima materiale", cosi' si vedono subito i materiali
for schermo_ui in bpy.data.screens:
    for area in schermo_ui.areas:
        if area.type == "VIEW_3D":
            for spazio in area.spaces:
                if spazio.type == "VIEW_3D":
                    spazio.shading.type = "MATERIAL"
                    spazio.clip_end = 200

bpy.ops.wm.save_as_mainfile(filepath=USCITA)
try:   # percorsi relativi: la cartella del progetto si puo' spostare senza perdere immagini
    bpy.ops.file.make_paths_relative()
    bpy.ops.wm.save_mainfile()
except Exception as e:
    print("Percorsi relativi non impostati:", e)
print(f"\nStanza salvata in {USCITA} ({len(bpy.data.objects)} oggetti)")
