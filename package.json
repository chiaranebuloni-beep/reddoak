{
  "name": "reddoak3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3130 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3130",
    "stanza:crea": "/Applications/Blender.app/Contents/MacOS/Blender --background --python blender/crea_stanza.py",
    "stanza:esporta": "/Applications/Blender.app/Contents/MacOS/Blender --background blender/stanza.blend --python blender/esporta_stanza.py && node blender/anteprime_foto.mjs",
    "stanza:punti": "/Applications/Blender.app/Contents/MacOS/Blender --background blender/stanza.blend --python blender/esporta_stanza.py -- --solo-dati",
    "stanza:bozza": "/Applications/Blender.app/Contents/MacOS/Blender --background blender/stanza.blend --python blender/esporta_stanza.py -- --bozza && node blender/anteprime_foto.mjs",
    "ghianda": "/Applications/Blender.app/Contents/MacOS/Blender --background --python blender/crea_ghianda.py && node -e \"require('sharp')('public/brand/ghianda-giro.png',{limitInputPixels:false}).webp({quality:86,alphaQuality:90}).toFile('public/brand/ghianda-giro.webp').then(()=>require('fs').unlinkSync('public/brand/ghianda-giro.png'))\"",
    "stanza:sera": "/Applications/Blender.app/Contents/MacOS/Blender --background blender/stanza.blend --python blender/esporta_stanza.py -- --vista sera && node blender/anteprime_foto.mjs",
    "anteprima": "vite build && vite preview --port 3131",
    "pubblica": "npx vercel deploy --prod --yes"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "vite": "^8.4.0"
  }
}
